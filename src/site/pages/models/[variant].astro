---
import path from "node:path";
import { loadCatalogue } from "../../../catalogue/load";
import type { Wrap } from "../../../domain/wrap";
import { VARIANTS, type VariantId } from "../../../domain/variants";
import TemplateLink from "../../components/TemplateLink.astro";
import WrapCard from "../../components/WrapCard.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const result = await loadCatalogue(path.resolve("content/wraps"));
  if (!result.ok) {
    throw new Error("catalogue load failed");
  }
  return (Object.keys(VARIANTS) as VariantId[]).map((variant) => ({
    params: { variant },
    props: { variant, wraps: result.catalogue.byVariant.get(variant) ?? [] },
  }));
}

type Props = { variant: VariantId; wraps: readonly Wrap[] };

const { variant, wraps } = Astro.props;
const info = VARIANTS[variant];
---

<Base title={`${info.label} wraps`}>
  <p class="back-link"><a href="/#vehicles">Back to all vehicles</a></p>
  <div class="page-heading">
  <h1 class="model-title">{info.label}</h1>
  <p class="variant">PNG template / {info.w} × {info.h}</p>
  <p>
    <TemplateLink variant={variant} />. Official templates stay in Tesla's repository.
  </p>

  </div>
  <div class="section-heading"><h2>Available designs</h2><span class="micro-label">{wraps.length} {wraps.length === 1 ? "design" : "designs"}</span></div>
  {
    wraps.length === 0 ? (
      <div class="empty-state"><p>There are no wraps yet for this variant.</p><a href="/#vehicles">Browse another vehicle</a></div>
    ) : (
      <ul class="wrap-grid">
        {wraps.map((wrap) => (
          <li>
            <WrapCard wrap={wrap} />
          </li>
        ))}
      </ul>
    )
  }
</Base>
