{
  "name": "tesla-wrap-workshop",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsx src/cli/check.ts",
    "build": "astro build",
    "check:dist": "tsx scripts/check-dist.ts",
    "postbuild:check": "tsx scripts/postbuild-check.ts",
    "verify:provenance": "tsx scripts/verify-provenance.ts",
    "hash:tesla": "tsx scripts/hash-tesla-files.ts",
    "legal:packet": "tsx scripts/legal-packet.ts",
    "legal:check": "tsx scripts/legal-packet.ts --check",
    "check:upstream": "tsx scripts/check-upstream.ts",
    "test:browser": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check && npm run verify:provenance && npm run build && npm run check:dist && npm run verify:gallery && npm run postbuild:check && npm run legal:check && npm run test:browser",
    "verify:gallery": "tsx scripts/verify-gallery.ts",
    "check:template-links": "tsx scripts/check-template-links.ts"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.0",
    "acorn": "8.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-ban-comments": "^1.0.3",
    "parse5": "7.3.0",
    "postcss": "8.5.32",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
